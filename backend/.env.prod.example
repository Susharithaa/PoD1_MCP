APP_ENV=prod
OPENAI_API_KEY=replace-with-real-key
MOCK_LLM=false
DATABASE_URL=postgresql://user:password@prod-host:5432/mcp_hub
UPLOAD_DIR=./uploads
CORS_ORIGINS=https://app.example.com
JWT_SECRET=replace-with-long-random-secret
ENCRYPTION_KEY=replace-with-fernet-key
READ_ONLY_MODE=false
EMERGENCY_STOP=false
DRY_RUN_TOOLS=false
MAX_TOOL_EXECUTION_MS=5000
