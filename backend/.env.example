OPENAI_API_KEY=sk-...
MOCK_LLM=false

# SQLite (default for local dev)
DATABASE_URL=sqlite:///./mcp_hub.db

# PostgreSQL (use this for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/mcp_hub

UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:5173

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Credential encryption — set any secret string to encrypt stored API credentials
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=

# ── SMTP (Gmail) ──────────────────────────────────────────────────────────────
# Use a Gmail App Password (not your regular Gmail password)
# Enable at: https://myaccount.google.com/apppasswords
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# ── Google OAuth2 ─────────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ── GitHub OAuth2 ────────────────────────────────────────────────────────────
# Create at: https://github.com/settings/developers → OAuth Apps → New OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# ── Frontend base URL ─────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
